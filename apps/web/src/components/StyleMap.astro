---
// Plots every style on two axes: how much the prompt dictates the implementation (x)
// and how much the output is verified against a contract (y). Values come from each YAML `map`.
import { styles, taxonomy } from '../lib/data';
import { l, ui, type Lang } from '../lib/i18n';
import { href } from '../lib/url';

interface Props {
  lang: Lang;
  /** Highlight one style (used on the style pages). */
  current?: string;
  /** Small version: only the current style is labeled. */
  compact?: boolean;
}

const { lang, current, compact = false } = Astro.props;
const t = ui[lang];
const { how, verification } = taxonomy.axes;
---

<figure class:list={['map', { compact }]}>
  <div class="map-frame">
    <div class="map-y" aria-hidden="true">
      <span>{l(verification.low, lang)}</span>
      <span>{l(verification.high, lang)} ↑</span>
    </div>
    <div class="map-plot" role="list" aria-label={t.styles.mapAlt}>
      {
        styles.map((s) => (
          <a
            role="listitem"
            href={href(lang, `/styles/${s.id}/`)}
            class:list={['map-dot', { flip: s.map.how > 55, current: s.id === current }]}
            style={`left:${s.map.how}%;bottom:${s.map.verification}%`}
            aria-current={s.id === current ? 'page' : undefined}
            aria-label={l(s.name, lang)}
            title={compact ? l(s.name, lang) : undefined}
          >
            <span class="mark" />
            <span class="label">{l(s.name, lang)}</span>
          </a>
        ))
      }
    </div>
    <div class="map-x" aria-hidden="true">
      <span>← {l(how.low, lang)}</span>
      <span>{l(how.high, lang)} →</span>
    </div>
  </div>
  {!compact && <figcaption>{l(taxonomy.note, lang)}</figcaption>}
</figure>
