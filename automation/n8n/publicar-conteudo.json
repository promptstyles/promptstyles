    {
      "id": "6a1f0c2e-1b7d-4c55-9a01-000000000003",
      "name": "Buscar aprovados",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput",
      "credentials": {
        "notionApi": {
          "name": "Notion Central"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "=https://api.notion.com/v1/databases/{{ $json.conteudoDbId }}/query",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2022-06-28"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filter: { and: [ { property: 'Projeto', relation: { contains: $json.projetoPageId } }, { property: 'Status', status: { equals: 'Aprovado' } }, { property: 'Data agendada', date: { on_or_before: $now.toISO() } } ] }, sorts: [ { property: 'Data agendada', direction: 'ascending' } ], page_size: 20 }) }}",
        "options": {}
      }
    },
    {
      "id": "6a1f0c2e-1b7d-4c55-9a01-000000000004",
      "name": "Preparar posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, -100],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One item per approved post. Posts that cannot go out get an `erro` and take the error path.\nconst SUPORTADAS = ['LinkedIn'];\nconst LIMITE_LINKEDIN = 3000;\nconst publicados = $getWorkflowStaticData('global').publicados || {};\nconst texto = (prop) => ((prop && (prop.rich_text || prop.title)) || []).map((t) => t.plain_text).join('');\n\nreturn ($input.first().json.results || []).map((page) => {\n  const p = page.properties;\n  const item = {\n    pageId: page.id,\n    titulo: texto(p['Título']) || 'Sem título',\n    plataforma: (p['Plataforma'] && p['Plataforma'].select && p['Plataforma'].select.name) || '',\n    formato: (p['Formato'] && p['Formato'].select && p['Formato'].select.name) || '',\n    texto: texto(p['Texto']).trim(),\n    midia: (p['Mídia'] && p['Mídia'].url) || '',\n    erro: '',\n  };\n\n  if (publicados[page.id]) {\n    // Published in an earlier run, but the Notion update failed. Never post twice.\n    item.erro = `Já foi publicado (${publicados[page.id]}), mas o Notion não foi atualizado. Confira o post e ajuste o Status.`;\n  } else if (!SUPORTADAS.includes(item.plataforma)) {\n    item.erro = `Este workflow ainda não publica em \"${item.plataforma || 'sem plataforma'}\".`;\n  } else if (!item.texto) {\n    item.erro = 'Texto vazio.';\n  } else if (item.texto.length > LIMITE_LINKEDIN) {\n    item.erro = `Texto com ${item.texto.length} caracteres. O LinkedIn aceita até ${LIMITE_LINKEDIN}.`;\n  }\n\n  return { json: item };\n});\n"
      }
    },
