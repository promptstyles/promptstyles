          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "6a1f0c2e-1b7d-4c55-9a01-000000000006",
      "name": "Publicar no LinkedIn",
      "type": "n8n-nodes-base.linkedIn",
      "typeVersion": 1,
      "position": [1100, -200],
      "onError": "continueErrorOutput",
      "notes": "Sem retry de propósito: repetir um post que talvez tenha saído pode publicar duas vezes. Escolha o seu perfil em Person depois de importar.",
      "credentials": {
        "linkedInOAuth2Api": {
          "name": "LinkedIn"
        }
      },
      "parameters": {
        "resource": "post",
        "operation": "create",
        "postAs": "person",
        "person": "",
        "text": "={{ $json.texto }}",
        "shareMediaCategory": "NONE",
        "additionalFields": {
          "visibility": "PUBLIC"
        }
      }
    },
    {
      "id": "6a1f0c2e-1b7d-4c55-9a01-000000000007",
      "name": "Guardar link",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, -300],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Builds the post URL and remembers the post, so a failed Notion update never leads to a second post.\nconst post = $('Preparar posts').item.json;\nconst urn = $json.urn || '';\nconst link = urn ? `https://www.linkedin.com/feed/update/${urn}/` : '';\nconst estado = $getWorkflowStaticData('global');\nestado.publicados = Object.assign({}, estado.publicados || {}, { [post.pageId]: link || 'link desconhecido' });\n\nreturn { json: Object.assign({}, post, { link }) };\n"
      }
    },
