        "jsonBody": "={{ JSON.stringify({ properties: { 'Status': { status: { name: 'Publicado' } }, 'Link publicado': { url: $json.link || null } } }) }}",
        "options": {}
      }
    },
    {
      "id": "6a1f0c2e-1b7d-4c55-9a01-000000000009",
