    {
      "id": "6a1f0c2e-1b7d-4c55-9a01-000000000010",
      "name": "Montar erro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 100],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Collects what went wrong for one post. Items arrive from three places:\n// \"Pode publicar?\" (with `erro`), the LinkedIn error output and the \"Marcar Publicado\" error output.\nconst post = $('Preparar posts').item.json;\nconst publicado = ($getWorkflowStaticData('global').publicados || {})[post.pageId];\nconst erro = $json.error;\nconst detalhe = $json.erro\n  || (typeof erro === 'string' ? erro : erro && (erro.message || JSON.stringify(erro)))\n  || $json.message\n  || 'Erro desconhecido';\nconst mensagem = publicado && !$json.erro\n  ? `Publicado no LinkedIn (${publicado}), mas o Notion não foi atualizado: ${detalhe}`\n  : detalhe;\n\nreturn { json: { pageId: post.pageId, titulo: post.titulo, plataforma: post.plataforma, mensagem } };\n"
      }
    },
