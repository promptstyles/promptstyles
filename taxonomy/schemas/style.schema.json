{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://promptstyles.org/schemas/style.schema.json",
  "title": "Prompt style",
  "description": "One prompt style in the Prompt Styles taxonomy. The file name must be <id>.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "order",
    "status",
    "name",
    "summary",
    "definition",
    "map",
    "example",
    "reveals",
    "use_when",
    "watch_out",
    "interview",
    "origin",
    "related"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/definitions/slug" },
    "order": { "type": "integer", "minimum": 1, "description": "Display order." },
    "status": {
      "enum": ["draft", "stable"],
      "description": "draft = open for discussion; stable = reviewed by maintainers."
    },
    "name": { "$ref": "common.schema.json#/definitions/text" },
    "aka": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Other names people use for this style."
    },
    "summary": { "$ref": "common.schema.json#/definitions/text" },
    "definition": { "$ref": "common.schema.json#/definitions/text" },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["how", "verification"],
      "description": "Approximate position on the style map, 0 to 100.",
      "properties": {
        "how": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "0 = describes only the outcome, 100 = dictates the implementation."
        },
        "verification": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "0 = trusts the output, 100 = verifies against an explicit contract."
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt"],
      "properties": {
        "note": { "$ref": "common.schema.json#/definitions/text" },
        "prompt": { "$ref": "common.schema.json#/definitions/text" }
      }
    },
    "reveals": { "$ref": "common.schema.json#/definitions/list" },
    "use_when": { "$ref": "common.schema.json#/definitions/list" },
    "watch_out": { "$ref": "common.schema.json#/definitions/list" },
    "interview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["look_for", "ask"],
      "properties": {
        "look_for": { "$ref": "common.schema.json#/definitions/list" },
        "ask": { "$ref": "common.schema.json#/definitions/list" }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "sources"],
      "properties": {
        "summary": { "$ref": "common.schema.json#/definitions/text" },
        "people": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "People who coined or popularized the term."
        },
        "date": { "$ref": "common.schema.json#/definitions/date" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "url"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "url": { "$ref": "common.schema.json#/definitions/httpsUrl" }
            }
          }
        }
      }
    },
    "related": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/definitions/slug" },
      "description": "Ids of related styles."
    }
  }
}
