{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://promptstyles.org/schemas/rubric.schema.json",
  "title": "Evaluation rubric",
  "description": "Two readings: the level (how well someone works with AI) and the focus (business vs tech).",
  "type": "object",
  "additionalProperties": false,
  "required": ["intro", "result_example", "levels", "focus", "scoring", "dimensions", "interview", "prepare"],
  "properties": {
    "intro": { "$ref": "common.schema.json#/definitions/text" },
    "result_example": { "$ref": "common.schema.json#/definitions/text" },
    "levels": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "name", "summary"],
        "properties": {
          "level": { "type": "integer", "minimum": 1 },
          "name": { "$ref": "common.schema.json#/definitions/text" },
          "aka": { "$ref": "#/definitions/aka" },
          "summary": { "$ref": "common.schema.json#/definitions/text" },
          "sources": { "$ref": "#/definitions/sources" }
        }
      }
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "axis", "positions"],
      "properties": {
        "title": { "$ref": "common.schema.json#/definitions/text" },
        "description": { "$ref": "common.schema.json#/definitions/text" },
        "axis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["low", "high"],
          "properties": {
            "low": { "$ref": "common.schema.json#/definitions/text" },
            "high": { "$ref": "common.schema.json#/definitions/text" }
          }
        },
        "positions": {
          "description": "Bands on a 0-100 axis (0 = business, 100 = tech), in order, without gaps.",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "from", "to", "name", "summary"],
            "properties": {
              "id": { "$ref": "common.schema.json#/definitions/slug" },
              "from": { "type": "integer", "minimum": 0, "maximum": 100 },
              "to": { "type": "integer", "minimum": 0, "maximum": 100 },
              "name": { "$ref": "common.schema.json#/definitions/text" },
              "aka": { "$ref": "#/definitions/aka" },
              "summary": { "$ref": "common.schema.json#/definitions/text" },
              "sources": { "$ref": "#/definitions/sources" }
            }
          }
        }
      }
    },
    "scoring": { "$ref": "common.schema.json#/definitions/list" },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "side", "name", "question", "descriptors"],
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/slug" },
          "side": {
            "description": "Which side of the focus axis this dimension measures. 'both' counts for the level only.",
            "enum": ["business", "tech", "both"]
          },
          "name": { "$ref": "common.schema.json#/definitions/text" },
          "question": { "$ref": "common.schema.json#/definitions/text" },
          "descriptors": {
            "description": "One descriptor per level, in level order.",
            "type": "array",
            "items": { "$ref": "common.schema.json#/definitions/text" }
          }
        }
      }
    },
    "interview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "steps", "scoring", "green_flags", "red_flags"],
      "properties": {
        "title": { "$ref": "common.schema.json#/definitions/text" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["minutes", "name", "description"],
            "properties": {
              "minutes": { "type": "integer", "minimum": 1 },
              "name": { "$ref": "common.schema.json#/definitions/text" },
              "description": { "$ref": "common.schema.json#/definitions/text" }
            }
          }
        },
        "scoring": { "$ref": "common.schema.json#/definitions/list" },
        "green_flags": { "$ref": "common.schema.json#/definitions/list" },
        "red_flags": { "$ref": "common.schema.json#/definitions/list" }
      }
    },
    "prepare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "items"],
      "properties": {
        "title": { "$ref": "common.schema.json#/definitions/text" },
        "items": { "$ref": "common.schema.json#/definitions/list" }
      }
    }
  },
  "definitions": {
    "aka": {
      "description": "Other names people use.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "$ref": "common.schema.json#/definitions/httpsUrl" }
        }
      }
    }
  }
}
