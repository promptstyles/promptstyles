{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://promptstyles.org/schemas/common.schema.json",
  "title": "Shared definitions",
  "definitions": {
    "text": {
      "description": "A string in every supported language.",
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "pt"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "pt": { "type": "string", "minLength": 1 }
      }
    },
    "list": {
      "description": "A list of strings in every supported language.",
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "pt"],
      "properties": {
        "en": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "pt": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    }
  }
}
